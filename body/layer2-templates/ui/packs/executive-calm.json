{
  "ui_pack_version": 2,
  "meta": {
    "name": "executive-calm",
    "description": "Low-noise executive visibility workspace",
    "version": "2"
  },
  "theme_tokens": {
    "option_label_max_chars": 24,
    "accent": "$success",
    "muted": "$text-muted",
    "panel_border_style": "round $surface-lighten-1",
    "sidebar_width": 24
  },
  "layout": {
    "kind": "executive-calm",
    "density": "compact"
  },
  "views": {
