      "options_density": "balanced",
      "show_secondary_hints": true,
      "status_bar_compact": false
    },
    "menu": {
      "preview_density": "balanced"
    }
  },
  "bindings": {},
  "assets": {
    "branding_title": "Battle Ready Armor",
    "branding_subtitle": "Ops Grid",
    "quotes": [
      "Track every signal. Miss nothing."
    ]
  },
  "hooks": {}
}
